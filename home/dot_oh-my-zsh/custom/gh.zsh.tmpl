#!/usr/bin/env zsh

eval "$(gh completion -s zsh)"

{{ if .work }}
# Wrapper around `gh` that auto-selects the GitHub account to use.
# Inspired by https://github.com/cli/cli/issues/12459
#
# Account resolution order:
#   1. --gh-account <name> / --gh-account=<name>  (wrapper-only, stripped before exec)
#   2. `git config github.account` for the current repository
#   3. whatever account gh currently has active
gh() {
  local gh_account=""
  local -a args=()

  # --gh-account is consumed here and never forwarded to the real gh command
  while (( $# )); do
    case "$1" in
      --gh-account)
        if [[ -z "$2" ]]; then
          echo "gh: --gh-account requires an account name" >&2
          return 1
        fi
        gh_account="$2"
        shift 2
        ;;
      --gh-account=*)
        gh_account="${1#--gh-account=}"
        if [[ -z "$gh_account" ]]; then
          echo "gh: --gh-account requires an account name" >&2
          return 1
        fi
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  if [[ -z "$gh_account" ]]; then
    gh_account=$(git config github.account 2>/dev/null)
  fi

  if [[ -n "$gh_account" ]]; then
    local gh_token
    if ! gh_token=$(command gh auth token --user "$gh_account" 2>/dev/null) || [[ -z "$gh_token" ]]; then
      echo "gh: no token found for account '$gh_account'" >&2
      return 1
    fi

    GH_TOKEN="$gh_token" command gh "${args[@]}"
    return $?
  fi

  command gh "${args[@]}"
}
{{ end }}
